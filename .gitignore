# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Telemetry data (large binary files)
*.ibt
*.csv
*.ld
*.ldx
# ...except the committed test fixtures: real telemetry trimmed to a few laps
# with every driver identity replaced. Built by tools/make_test_fixture.py.
!tests/data/*.ibt

# Test output
test_output/

# iRacing API cache (contains account-specific data)
cache/

# Build output
dist/
build/
installer/Output/

# Backstop for RR-023. Auto-generated track maps now go to
# %LOCALAPPDATA%\Tenths\tracks (config.USER_TRACKS_DIR) and the autouse
# _never_write_track_maps_into_the_repo fixture redirects them in tests.
# This pattern only catches a regression in either of those; the committed
# hand-authored maps in tracks/ are unaffected.
tracks/test_track.md
tracks/test_*.md
